---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Página no encontrada',
};
---

<Layout metadata={metadata}>
  <section class="flex h-full items-center p-16">
    <div class="container mx-auto my-8 flex flex-col items-center justify-center px-5">
      <div class="max-w-md text-center">
        <h2 class="mb-8 text-9xl font-bold">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold">No encontramos esta página.</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          Puede que el enlace haya cambiado. Vuelve al inicio o revisa las secciones principales del sitio.
        </p>
        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={getHomePermalink()} class="btn-primary">Ir al inicio</a>
          <a href={getPermalink('/contacto')} class="btn">Contacto</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
