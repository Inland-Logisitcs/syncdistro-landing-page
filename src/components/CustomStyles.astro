---
// La familia tipográfica la provee la Fonts API nativa de Astro (ver `fonts` en
// astro.config.ts y <Font /> en Layout.astro), expuesta como `--font-inter`.
// Para cambiar de tipografía, cambiar la entrada en `fonts` y reapuntar
// las variables `--aw-font-*` de abajo.
//
// Paleta SyncDistro: azul petróleo / teal tomado de la app móvil
// (botones y navegación de las capturas en public/img/app).
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(11 92 116); /* #0B5C74 */
    --aw-color-secondary: rgb(8 68 87); /* #084457 */
    --aw-color-accent: rgb(23 138 168); /* #178AA8 */

    --aw-color-text-heading: rgb(9 26 33);
    --aw-color-text-default: rgb(17 34 41);
    --aw-color-text-muted: rgb(17 34 41 / 68%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(6 22 29); /* #06161D */

    ::selection {
      background-color: rgb(23 138 168 / 25%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(30 130 158); /* aclarado para contraste en oscuro */
    --aw-color-secondary: rgb(18 106 132);
    --aw-color-accent: rgb(94 205 227);

    --aw-color-text-heading: rgb(240 249 252);
    --aw-color-text-default: rgb(224 240 245);
    --aw-color-text-muted: rgb(224 240 245 / 66%);
    --aw-color-bg-page: rgb(6 22 29);

    ::selection {
      background-color: rgb(23 138 168 / 45%);
      color: snow;
    }
  }
</style>
