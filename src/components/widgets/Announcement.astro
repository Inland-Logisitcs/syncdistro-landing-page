---
import { PLAY_STORE_URL } from '~/links';
---

<div
  class="relative hidden gap-1 overflow-hidden px-3 py-2 text-sm text-ellipsis whitespace-nowrap text-slate-300 md:flex bg-slate-900 dark:border-b dark:border-slate-800 dark:bg-transparent dark:text-slate-400"
>
  <span
    class="mr-0.5 inline-block bg-white/20 px-1 py-0.5 text-xs font-semibold text-slate-100 rtl:mr-0 rtl:ml-0.5 dark:bg-slate-700 dark:text-slate-300"
    >NUEVO</span
  >
  <a
    href={PLAY_STORE_URL}
    target="_blank"
    rel="noopener"
    class="font-medium text-slate-300 hover:underline dark:text-slate-400"
    >La app para vendedores ya está disponible en Google Play »</a
  >
</div>
