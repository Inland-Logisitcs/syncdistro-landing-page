---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-2 self-center whitespace-nowrap">
  <svg
    class="h-8 w-8 shrink-0 text-primary"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Marcador de ubicación: la visita en campo -->
    <path
      d="M16 3.5c-4.28 0-7.75 3.36-7.75 7.5 0 5.42 6.3 11.9 7.1 12.7a.93.93 0 0 0 1.3 0c.8-.8 7.1-7.28 7.1-12.7 0-4.14-3.47-7.5-7.75-7.5Z"
      fill="currentColor"></path>
    <!-- Flechas de sincronización dentro del marcador -->
    <path
      d="M12.9 11.4a3.3 3.3 0 0 1 5.4-1.5m.9 2.1a3.3 3.3 0 0 1-5.4 1.5"
      stroke="white"
      stroke-width="1.5"
      stroke-linecap="round"></path>
    <path d="M18.5 8.2v2.1h-2.1M13.5 14.6v-2.1h2.1" stroke="white" stroke-width="1.5" stroke-linecap="round"></path>
    <!-- Trazo de la ruta -->
    <path
      d="M6 27.5c2.6-2.1 5-2.1 7.6 0 2.6 2.1 5 2.1 7.6 0"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      opacity="0.55"></path>
  </svg>
  <span class="text-2xl font-bold tracking-tight text-gray-900 md:text-xl dark:text-white">
    {SITE?.name}
  </span>
</span>
