---
import { SITE } from 'astrowind:config';
import Image from '~/components/common/Image.astro';

// Marca oficial de SyncDistro. El icono ya es turquesa (#28D8C0), así que
// funciona igual sobre fondo claro y oscuro. En el logotipo, "Distro" se pone
// turquesa solo en tema oscuro, igual que en la app.
---

<span class="flex items-center gap-2 self-center whitespace-nowrap">
  <Image
    src="~/assets/images/syncdistro-logo.png"
    alt=""
    width={36}
    height={36}
    widths={[36, 72]}
    layout="fixed"
    format="webp"
    loading="eager"
    class="h-9 w-9 shrink-0"
  />
  <span class="text-2xl font-bold tracking-tight text-gray-900 md:text-xl dark:text-white">
    Sync<span class="dark:text-[#28d8c0]">Distro</span>
  </span>
  <span class="sr-only">{SITE?.name}</span>
</span>
