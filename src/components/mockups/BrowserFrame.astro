---
/**
 * Marco de navegador para las vistas del sistema web.
 *
 * Mientras no existan capturas reales del sistema web, dentro de este marco se
 * colocan los placeholders de `src/components/mockups/web/*`. Cuando lleguen
 * las capturas, basta sustituir el contenido del slot por un <img>.
 */
export interface Props {
  /** Texto que aparece en la barra de direcciones */
  url?: string;
  /** Título de la vista, mostrado como pestaña */
  label?: string;
  /** Muestra la etiqueta "Vista ilustrativa" */
  isPlaceholder?: boolean;
  class?: string;
}

const { url = 'app.syncdistro.com', label, isPlaceholder = false, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xl dark:border-slate-700 dark:bg-slate-900',
    className,
  ]}
>
  <div
    class="flex items-center gap-3 border-b border-gray-200 bg-gray-100 px-3 py-2 dark:border-slate-700 dark:bg-slate-800"
  >
    <div class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-gray-300 dark:bg-slate-600"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-gray-300 dark:bg-slate-600"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-gray-300 dark:bg-slate-600"></span>
    </div>
    <div
      class="flex-1 truncate rounded-md bg-white px-2.5 py-1 text-[0.7rem] text-gray-500 dark:bg-slate-900 dark:text-slate-400"
    >
      {url}{label ? ` / ${label}` : ''}
    </div>
    {
      isPlaceholder && (
        <span class="hidden shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-[0.65rem] font-semibold tracking-wide text-primary uppercase sm:inline-block dark:bg-primary/20">
          Vista ilustrativa
        </span>
      )
    }
  </div>
  <div class="bg-white dark:bg-slate-900">
    <slot />
  </div>
</div>
