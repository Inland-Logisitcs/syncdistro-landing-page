---
/**
 * Placeholder: detalle de una visita en el sistema web, con la transcripción de
 * la nota de voz y la información que la IA extrae de ella.
 * Contenido de muestra, no corresponde a una visita real.
 */
const extracted = [
  { label: 'Resultado', value: 'Venta realizada' },
  { label: 'Productos', value: '3 líneas' },
  { label: 'Precio acordado', value: 'Lista mayorista' },
  { label: 'Seguimiento', value: 'En 15 días' },
];

const products = [
  { code: 'SKU-1042', name: 'Producto A · caja 24 u.', qty: '4' },
  { code: 'SKU-2210', name: 'Producto B · caja 12 u.', qty: '2' },
  { code: 'SKU-3378', name: 'Producto C · display', qty: '1' },
];
---

<div class="grid gap-4 p-4 sm:p-5 md:grid-cols-5">
  <!-- Columna izquierda: audio + transcripción -->
  <div class="md:col-span-3">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-[0.65rem] font-semibold tracking-wide text-gray-500 uppercase dark:text-slate-400">Visita</p>
        <p class="text-sm font-bold">Abarrotería Central · Parada 3</p>
      </div>
      <span
        class="rounded-full bg-emerald-100 px-2 py-0.5 text-[0.6rem] font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300"
        >Venta realizada</span
      >
    </div>

    <!-- Reproductor de la nota de voz -->
    <div class="mt-3 flex items-center gap-3 rounded-lg border border-gray-200 px-3 py-2.5 dark:border-slate-700">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-white">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"
          ><path d="M8 5v14l11-7z"></path></svg
        >
      </span>
      <div class="flex h-6 flex-1 items-end gap-[2px]">
        {
          [5, 11, 7, 16, 22, 14, 9, 18, 24, 12, 7, 15, 20, 10, 6, 13, 19, 8, 14, 21, 11, 6, 16, 9].map((h) => (
            <span class="w-full rounded-sm bg-primary/40 dark:bg-primary/50" style={`height:${h}px`} />
          ))
        }
      </div>
      <span class="shrink-0 text-[0.65rem] text-muted">02:41</span>
    </div>

    <!-- Transcripción -->
    <div class="mt-3 rounded-lg bg-gray-50 p-3 dark:bg-slate-800/60">
      <div class="flex items-center gap-2">
        <p class="text-[0.65rem] font-semibold tracking-wide text-gray-500 uppercase dark:text-slate-400">
          Transcripción automática
        </p>
        <span class="rounded bg-white px-1.5 py-0.5 text-[0.6rem] font-medium text-muted dark:bg-slate-900">ES</span>
      </div>
      <p class="mt-2 text-xs leading-relaxed text-muted">
        “…me interesa el producto A, mándame cuatro cajas para el próximo pedido. Del producto B con dos me alcanza por
        ahora. Del display déjame uno para probarlo en el mostrador. Vuelve a pasar en unos quince días para revisar
        cómo salió…”
      </p>
    </div>
  </div>

  <!-- Columna derecha: extracción con IA -->
  <div class="md:col-span-2">
    <div class="rounded-lg border border-primary/30 bg-primary/5 p-3 dark:border-primary/40 dark:bg-primary/10">
      <div class="flex items-center gap-1.5">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-primary" fill="currentColor" aria-hidden="true">
          <path d="M12 2l1.9 5.6L19.5 9l-5.6 1.9L12 16.5l-1.9-5.6L4.5 9l5.6-1.4L12 2Z"></path>
        </svg>
        <p class="text-[0.65rem] font-semibold tracking-wide text-primary uppercase">Detectado por IA</p>
      </div>
      <dl class="mt-2 space-y-1.5">
        {
          extracted.map(({ label, value }) => (
            <div class="flex justify-between gap-2 text-xs">
              <dt class="text-muted">{label}</dt>
              <dd class="text-right font-semibold">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="mt-3 overflow-hidden rounded-lg border border-gray-200 dark:border-slate-700">
      {
        products.map(({ code, name, qty }) => (
          <div class="flex items-center justify-between gap-2 border-b border-gray-100 px-2.5 py-2 text-[0.7rem] last:border-b-0 dark:border-slate-800">
            <div class="min-w-0">
              <p class="truncate font-medium">{name}</p>
              <p class="text-muted">{code}</p>
            </div>
            <span class="shrink-0 rounded bg-gray-100 px-1.5 py-0.5 font-semibold dark:bg-slate-800">× {qty}</span>
          </div>
        ))
      }
    </div>

    <div class="mt-3 flex gap-2">
      <span class="flex-1 rounded-md bg-primary py-1.5 text-center text-[0.7rem] font-semibold text-white">
        Confirmar y crear pedido
      </span>
      <span
        class="rounded-md border border-gray-300 px-2.5 py-1.5 text-[0.7rem] font-semibold text-muted dark:border-slate-600"
        >Corregir</span
      >
    </div>
  </div>
</div>
