---
/**
 * Placeholder: módulo de pedidos y resultado del envío al ERP.
 * Datos de muestra.
 */
const orders = [
  { id: 'SD-002418', customer: 'Abarrotería Central', total: '1,240.00', status: 'Creado en ERP' },
  { id: 'SD-002417', customer: 'Deli La Esquina', total: '318.50', status: 'Creado en ERP' },
  { id: 'SD-002416', customer: 'Supermercado del Valle', total: '2,905.75', status: 'Pendiente' },
  { id: 'SD-002415', customer: 'Minimarket El Roble', total: '486.00', status: 'Error' },
];

const styles: Record<string, string> = {
  'Creado en ERP': 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
  Pendiente: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
  Error: 'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300',
};
---

<div class="p-4 sm:p-5">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-[0.65rem] font-semibold tracking-wide text-gray-500 uppercase dark:text-slate-400">Pedidos</p>
      <p class="text-sm font-bold">Envío al ERP</p>
    </div>
    <span
      class="rounded-md border border-gray-300 px-2.5 py-1 text-[0.7rem] font-semibold text-muted dark:border-slate-600"
    >
      Ver logs
    </span>
  </div>

  <div class="mt-4 overflow-hidden rounded-lg border border-gray-200 dark:border-slate-700">
    <div
      class="grid grid-cols-12 gap-2 border-b border-gray-200 bg-gray-50 px-3 py-2 text-[0.65rem] font-semibold tracking-wide text-gray-500 uppercase dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400"
    >
      <div class="col-span-3">Pedido</div>
      <div class="col-span-5">Cliente</div>
      <div class="col-span-2 text-right">Total</div>
      <div class="col-span-2 text-right">Integración</div>
    </div>
    {
      orders.map(({ id, customer, total, status }) => (
        <div class="grid grid-cols-12 items-center gap-2 border-b border-gray-100 px-3 py-2.5 text-xs last:border-b-0 dark:border-slate-800">
          <div class="col-span-3 truncate font-mono text-[0.7rem] font-medium">{id}</div>
          <div class="col-span-5 truncate">{customer}</div>
          <div class="col-span-2 text-right font-medium">{total}</div>
          <div class="col-span-2 text-right">
            <span
              class:list={[
                'inline-block rounded-full px-2 py-0.5 text-[0.6rem] font-semibold whitespace-nowrap',
                styles[status],
              ]}
            >
              {status}
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Traza del envío -->
  <div class="mt-4 rounded-lg bg-gray-50 p-3 dark:bg-slate-800/60">
    <p class="text-[0.65rem] font-semibold tracking-wide text-gray-500 uppercase dark:text-slate-400">
      Trazabilidad · SD-002418
    </p>
    <ol class="mt-2 space-y-1.5 text-[0.7rem]">
      <li class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-muted">Pedido construido desde la visita</span>
      </li>
      <li class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-muted">Confirmado por el vendedor</span>
      </li>
      <li class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-muted">Enviado al endpoint de creación de pedidos</span>
      </li>
      <li class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span class="font-medium">Respuesta del ERP: creado correctamente</span>
      </li>
    </ol>
  </div>
</div>
