---
/**
 * Placeholder: listado de clientes del sistema web.
 * Datos genéricos de muestra, no corresponden a clientes reales.
 */
const rows = [
  { name: 'Abarrotería Central', type: 'Bodega', city: 'Zona 1', tax: 'TAX-4820', state: 'Cliente' },
  { name: 'Deli La Esquina', type: 'Deli', city: 'Zona 10', tax: 'TAX-1174', state: 'Cliente' },
  { name: 'Supermercado del Valle', type: 'Supermercado', city: 'Zona 11', tax: 'TAX-9063', state: 'Cliente' },
  { name: 'Tienda Doña Marta', type: 'Tienda', city: 'Zona 7', tax: '—', state: 'Posible' },
  { name: 'Minimarket El Roble', type: 'Minimarket', city: 'Zona 15', tax: 'TAX-3391', state: 'Posible' },
  { name: 'Distribuidora San Juan', type: 'Mayorista', city: 'Mixco', tax: 'TAX-7708', state: 'Cliente' },
];
---

<div class="p-4 sm:p-5">
  <!-- Barra de filtros -->
  <div class="flex flex-wrap items-center gap-2">
    <div
      class="flex min-w-[10rem] flex-1 items-center gap-2 rounded-md border border-gray-200 px-2.5 py-1.5 text-xs text-gray-400 dark:border-slate-700 dark:text-slate-500"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-3.5 w-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      Buscar por nombre, dirección, teléfono o tax ID
    </div>
    <span class="rounded-md bg-primary px-2.5 py-1.5 text-xs font-semibold text-white">Nuevo cliente</span>
  </div>

  <!-- Tabla -->
  <div class="mt-4 overflow-hidden rounded-lg border border-gray-200 dark:border-slate-700">
    <div
      class="grid grid-cols-12 gap-2 border-b border-gray-200 bg-gray-50 px-3 py-2 text-[0.65rem] font-semibold tracking-wide text-gray-500 uppercase dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400"
    >
      <div class="col-span-5">Cliente</div>
      <div class="col-span-2 hidden sm:block">Tipo</div>
      <div class="col-span-2">Zona</div>
      <div class="col-span-2 hidden sm:block">Tax ID</div>
      <div class="col-span-3 sm:col-span-1 text-right">Estado</div>
    </div>
    {
      rows.map(({ name, type, city, tax, state }) => (
        <div class="grid grid-cols-12 items-center gap-2 border-b border-gray-100 px-3 py-2.5 text-xs last:border-b-0 dark:border-slate-800">
          <div class="col-span-5 flex items-center gap-2">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary dark:bg-primary/20">
              <svg
                viewBox="0 0 24 24"
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <>
                  <path d="M3 9h18l-1.5-4.5h-15L3 9Z" />
                  <path d="M4.5 9v10.5h15V9" />
                </>
              </svg>
            </span>
            <span class="truncate font-medium">{name}</span>
          </div>
          <div class="col-span-2 hidden truncate text-muted sm:block">{type}</div>
          <div class="col-span-2 truncate text-muted">{city}</div>
          <div class="col-span-2 hidden truncate text-muted sm:block">{tax}</div>
          <div class="col-span-3 text-right sm:col-span-1">
            <span
              class:list={[
                'inline-block rounded-full px-2 py-0.5 text-[0.6rem] font-semibold whitespace-nowrap',
                state === 'Cliente'
                  ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300'
                  : 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
              ]}
            >
              {state}
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-3 flex items-center justify-between text-[0.7rem] text-muted">
    <span>6 de 128 registros</span>
    <span class="flex gap-1">
      <span class="rounded border border-gray-200 px-1.5 dark:border-slate-700">‹</span>
      <span class="rounded bg-primary px-1.5 text-white">1</span>
      <span class="rounded border border-gray-200 px-1.5 dark:border-slate-700">2</span>
      <span class="rounded border border-gray-200 px-1.5 dark:border-slate-700">›</span>
    </span>
  </div>
</div>
